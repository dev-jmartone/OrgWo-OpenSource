# =============================================================
# OrgWo — Open Work Orders & Workspace Orchestrator (.env)
# =============================================================

# Clave secreta de Flask para firmar cookies de sesión y tokens internos.
# Generar una aleatoria en producción (ej. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key

# Entorno activo: QA o PROD
# QA   -> usa database/data_qa.db y REMEDY_BASE_URL_QA
# PROD -> usa database/data.db    y REMEDY_BASE_URL_PROD
ENV=QA
HOST=0.0.0.0
PORT=5000

# ── Modo Simulación / Demo de Remedy ─────────────────────────
# true: simula las respuestas de BMC Remedy ARS en memoria (ideal para demos y GitHub showcase).
# false: conecta a los servidores reales configurados abajo.
REMEDY_MOCK_MODE=true

# ── Integración BMC Remedy AR System ─────────────────────────
# Endpoints de la API REST de Remedy ITSM de tu organización
REMEDY_BASE_URL_PROD=https://remedy.yourcompany.com
REMEDY_BASE_URL_QA=https://remedy-qa.yourcompany.com

# Nombre de la compañía por defecto para la creación de tickets en Remedy
REMEDY_DEFAULT_COMPANY=EMPRESA

# Elemento de Configuración (ServiceCI) por defecto en Remedy
REMEDY_DEFAULT_SERVICE_CI=Servicios TI Corporativos
REMEDY_DEFAULT_SERVICE_RECON_ID=

# Grupos resolutores asignados de Remedy (separados por coma)
REMEDY_ASSIGNED_GROUPS=MESA DE AYUDA TI, SOPORTE TECNICO, COMUNICACIONES MOVILES

# ── Validación de Correos y Directorio ────────────────────────
# Dominios corporativos permitidos para los usuarios (separados por coma)
# Dejar vacío para permitir cualquier correo válido
ALLOWED_EMAIL_DOMAINS=empresa.com,subsidiaria.com,servicios.com,proveedor.com
